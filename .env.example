PORT=3000
NODE_ENV=development
VITE_ADMIN_EMAIL=seu-email-admin@exemplo.com

# Opcional para EasyPanel/VPS sem firebase-applet-config.json no Git:
# Cole o JSON inteiro do firebase-applet-config.json em FIREBASE_CONFIG_JSON
# ou preencha as variáveis individuais abaixo:
# FIREBASE_CONFIG_JSON={"projectId":"...","appId":"...","apiKey":"...","authDomain":"...","firestoreDatabaseId":"(default)"}
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_DATABASE_ID=(default)
